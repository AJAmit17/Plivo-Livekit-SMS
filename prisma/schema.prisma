// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

model Room {
    id            String     @id @default(auto()) @map("_id") @db.ObjectId
    roomId        String     @unique
    status        RoomStatus @default(WAITING)
    customerPhone String
    ttlMinutes    Int        @default(60)
    createdAt     DateTime   @default(now())
    updatedAt     DateTime   @updatedAt
    expiresAt     DateTime

    participants Participant[]
    smsReceipts  SmsReceipt[]
    callSummary  CallSummary?
    recordings   Recording[]

    @@index([status])
    @@index([expiresAt])
}

model Participant {
    id       String          @id @default(auto()) @map("_id") @db.ObjectId
    roomId   String          @db.ObjectId
    identity String
    role     ParticipantRole
    joinedAt DateTime        @default(now())
    leftAt   DateTime?

    room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

    @@index([roomId])
}

model SmsReceipt {
    id          String       @id @default(auto()) @map("_id") @db.ObjectId
    roomId      String       @db.ObjectId
    messageUuid String       @unique
    from        String
    to          String
    text        String
    status      SmsStatus    @default(QUEUED)
    direction   SmsDirection
    deliveredAt DateTime?
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt

    room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

    @@index([roomId])
}

model CallSummary {
    id                String   @id @default(auto()) @map("_id") @db.ObjectId
    roomId            String   @unique @db.ObjectId
    duration          Int // in seconds
    participantCount  Int
    connectionQuality String? // JSON string with quality metrics
    recordingUrls     String[]
    notes             String?
    createdAt         DateTime @default(now())

    room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Recording {
    id        String          @id @default(auto()) @map("_id") @db.ObjectId
    roomId    String          @db.ObjectId
    egressId  String          @unique
    status    RecordingStatus @default(STARTING)
    url       String?
    duration  Int? // in seconds
    startedAt DateTime        @default(now())
    endedAt   DateTime?

    room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

    @@index([roomId])
}

enum RoomStatus {
    WAITING
    ACTIVE
    ENDED
    EXPIRED
}

enum ParticipantRole {
    CUSTOMER
    AGENT
}

enum SmsStatus {
    QUEUED
    SENT
    DELIVERED
    FAILED
    UNDELIVERED
}

enum SmsDirection {
    INBOUND
    OUTBOUND
}

enum RecordingStatus {
    STARTING
    ACTIVE
    ENDED
    FAILED
}
